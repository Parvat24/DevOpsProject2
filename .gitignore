# =========================================================================
# TERRAFORM RULES
# =========================================================================

# Local .terraform directories (contains plugins, providers, and modules)
**/.terraform/*

# .tfstate files (Contains plain-text secrets and current infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (Contains environment-specific sensitive variables)
*.tfvars
*.tfvars.json

# Ignore override files 
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Include tfplan files to ignore execution plan outputs
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc


# =========================================================================
# NODE.JS / JAVASCRIPT RULES
# =========================================================================

# Dependency directories (Bulky external modules)
node_modules/
jspm_packages/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul or jest
coverage
.nyc_output

# Next.js build output
.next/

# Nuxt.js build output
.nuxt/

# Gatsby files
.cache/

# Production build outputs
build/
dist/

# TypeScript cache
*.tsbuildinfo


# =========================================================================
# GENERAL / ENVIRONMENT CONFIGURATIONS
# =========================================================================

# Local environment secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.envrc

# IDE / Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

**/*.txt
**/*.exe